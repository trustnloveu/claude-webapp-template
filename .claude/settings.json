{
  "permissions": {
    "ask": [
      "Bash(gh pr merge:*)",
      "Bash(gh release create:*)",
      "Bash(git tag:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm install:*)",
      "Bash(yarn add:*)",
      "Bash(pip install:*)",
      "Bash(uv add:*)",
      "Bash(vercel:*)",
      "Bash(fly deploy:*)",
      "Bash(railway up:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin release/*:*)",
      "Bash(git push origin dev:*)",
      "Bash(git push origin prd:*)",
      "Edit(./packages/shared/generated/**)",
      "Write(./packages/shared/generated/**)",
      "Skill(speckit-implement)",
      "Skill(speckit-converge)",
      "Edit(./.specify/scripts/**)",
      "Write(./.specify/scripts/**)",
      "Edit(./.specify/templates/**)",
      "Write(./.specify/templates/**)",
      "Edit(./.claude/skills/speckit-*/**)",
      "Write(./.claude/skills/speckit-*/**)",
      "Edit(./.claude/skills/ui-ux-pro-max/**)",
      "Write(./.claude/skills/ui-ux-pro-max/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-dangerous.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-tests-on-stop.sh"
          }
        ]
      }
    ]
  }
}
